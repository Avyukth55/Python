from ai_model import generate_response
SYSTEM_PROMPT="""You are a Math Mastermind.
For every math problem:
1) Show step-by-step solution
2) Explain reasoning
3) Give alternate method if possible
4) Verify the answer
5) Use proper notation
6) Break complex problems into parts
Format: Problem -> Steps -> Final Answer -> Concepts used"""
history=[]
def solve(problem, level):
    conversation="\n\n".join(
        f"User: {q}\nAssistant: {a}" for q, a in history
    )
    prompt=f"""{SYSTEM_PROMPT}
    Previous Conversation:
    {conversation}
    Current Math Problem ({level}):
    {problem}
    Answer the current problem while considering the previous conversation"""
    return generate_response(prompt, temperature=0.1, max_tokens=1024)
while True:
    problem=input("\nEnter math problem (or 'exit'):")
    if problem.lower()=='exit':
        break
    if not problem.strip():
        print("Please enter a problem")
        continue
    level=input("Level(Basic/Intermediate/Advanced):")
    answer=solve(problem, level)
    history.append((problem, answer))
    print("\n-----Solution-----")
    print(answer) 
print("\n----Conversation History-----")
for i,(q, a) in enumerate(history, 1):
    print(f"\nQ. {i} {q}\nA{i}:{a}")   