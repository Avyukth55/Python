import requests
url="https://opentdb.com/api.php?amount=5&type=multiple"
response=requests.get(url)
if response.status_code==200:
    trivia_data=response.json()
    score=0
    print("Welcome to the game")
    print("Answer the following questions")
    question_no=0
    for question_data in trivia_data["results"]:
        question_no+=1
        print(f"Question {question_no}: {question_data['question']}")
        options=question_data["incorrect_answers"]+[question_data["correct_answer"]]
        options=sorted(options)
        option_no=1
        for option in options:
            print(f"{option_no}. {option}")
            option_no+=1
        user_answer=input("Your answer (1/2/3/4):")
        if options[int(user_answer)-1]==question_data["correct_answer"]:
            print("Correct!")
            score+=1
        else:
            print(f"Incorrect answer! Correct answer = {question_data["correct_answer"]}")
    print(score)
else:
    print("Could not fetch the data")